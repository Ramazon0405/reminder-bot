# --- Required -------------------------------------------------------------
# Token from @BotFather (see README step 1)
BOT_TOKEN=123456789:AAYourBotFatherTokenHere

# --- Optional -------------------------------------------------------------
# Timezone used for all reminder times and the daily summary
TZ_NAME=Asia/Tashkent

# When the automatic daily summary is sent (HH:MM in TZ_NAME)
SUMMARY_TIME=23:00

# Tesseract languages for OCR. "eng" alone works for digits;
# add more if schedules include text in other languages: eng+rus+uzb
OCR_LANG=eng

# Where the SQLite database lives (persistent volume in Docker)
DB_PATH=data/bot.db
